# DART OpenAPI 인증키
# https://opendart.fss.or.kr 에서 발급
DART_API_KEY=your_dart_api_key_here

# Naver 검색 API (국내 뉴스 수집)
# https://developers.naver.com/apps 에서 앱 등록 후 발급
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# NewsAPI (영문/글로벌 뉴스, 선택)
# https://newsapi.org 에서 무료 발급 (월 100회 무료 플랜)
# 미설정 시 GDELT API (키 불필요)로 자동 fallback
NEWS_API_KEY=your_newsapi_key_here

# 한국은행 ECOS API (국내 매크로 지표, 선택)
# https://ecos.bok.or.kr → 인증키 신청
ECOS_API_KEY=your_ecos_api_key_here

# FRED API (미국/글로벌 지표, 선택)
# https://fred.stlouisfed.org/docs/api/api_key.html 에서 무료 발급
FRED_API_KEY=your_fred_api_key_here
